ComboBoxPopupScrollMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #e0e0e0
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #101010
    background-color: #ffffff

  $disabled:
    color: #a8a8a866

ComboBoxPopupScrollMenu < UIPopupScrollMenu
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_combobox_neutral
  image-color: #ffffff
  image-clip: 0 69 91 23
  image-border: 4

