TextEdit < UITextEdit
  font: verdana-11px-antialised
  color: #f2f5f7
  size: 86 22
  text-offset: 0 4
  opacity: 1
  padding: 4
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_input_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  selection-color: #101010
  selection-background-color: #ffffff
  $focus:
    image-color: #ffffff
    image-clip: 0 46 22 23
  $disabled:
    color: #a8a8a866
    image-color: #70707066
    opacity: 0.5

PasswordTextEdit < TextEdit
  text-hidden: true

MultilineTextEdit < TextEdit
  multiline: true
