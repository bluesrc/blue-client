ScrollBarSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 13 17
  background-color: #686868
  border-width: 0
  $hover:
    background-color: #ffffff
  $pressed:
    background-color: #d2d2d2
  $disabled:
    background-color: #48484866

ScrollBarValueLabel < Label
  id: valueLabel
  anchors.fill: parent
  color: white
  text-align: center

VerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 13
  height: 39
  background-color: alpha
  border-width: 0
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 0 13 13
    image-color: #ffffff
    size: 13 13
    $hover:
      image-clip: 13 0 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 0 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 13 13
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 13 13 13
    image-color: #ffffff
    $hover:
      image-clip: 13 13 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 13 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  ScrollBarSlider

  ScrollBarValueLabel

HorizontalScrollBar < UIScrollBar
  orientation: horizontal
  height: 13
  width: 39
  background-color: alpha
  border-width: 0

  $disabled:
    color: #a8a8a866

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 39 13 13
    image-color: #ffffff
    size: 13 13
    $hover:
      image-clip: 13 39 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 39 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 13 13
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 52 13 13
    image-color: #ffffff
    $hover:
      image-clip: 13 52 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 52 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  ScrollBarSlider

  ScrollBarValueLabel
