ComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #f2f5f7
  size: 91 23
  text-offset: 3 0
  text-align: left
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_combobox_neutral
  image-color: #ffffff
  image-border: 4
  image-border-right: 19
  image-clip: 0 0 91 23

  $hover !disabled:
    image-color: #ffffff
    image-clip: 0 23 91 23

  $on:
    image-color: #ffffff
    image-clip: 0 46 91 23
    color: #101010

  $disabled:
    color: #a8a8a866
    image-color: #70707066
    opacity: 0.8

