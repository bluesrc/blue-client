PopupMenuButton < UIButton
  height: 18
  size: 0 21
  text-offset: 4 0
  text-align: left
  font: verdana-11px-antialised

  color: #d2d2d2
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #263944

  $disabled:
    color: #607180

PopupMenuShortcutLabel < Label
  font: verdana-11px-antialised
  text-align: right
  anchors.fill: parent
  margin-right: 2
  margin-left: 5

PopupMenuSeparator < UIWidget
  margin-left: 2
  margin-right: 2
  margin-bottom: 1
  background-color: #484848
  height: 1
  phantom: true

PopupMenu < UIPopupMenu
  width: 50
  background-color: #181818ee
  border-width: 1
  border-color: #686868
  padding: 4

PopupScrollMenuButton < UIButton
  height: 18
  size: 0 21
  text-offset: 4 0
  text-align: left
  font: verdana-11px-antialised

  color: #d2d2d2
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #263944

  $disabled:
    color: #607180

PopupScrollMenuShortcutLabel < Label
  font: verdana-11px-antialised
  text-align: right
  anchors.fill: parent
  margin-right: 2
  margin-left: 5

PopupScrollMenuSeparator < UIWidget
  margin-left: 2
  margin-right: 2
  margin-bottom: 1
  background-color: #484848
  height: 1
  phantom: true

PopupScrollMenu < UIPopupScrollMenu
  width: 50
  background-color: #181818ee
  border-width: 1
  border-color: #686868
  padding: 4
