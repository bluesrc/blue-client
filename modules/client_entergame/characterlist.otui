CharacterPokemonSlot < Panel
  size: 52 52
  background-color: #181818cc
  border-width: 1
  border-color: #303030
  phantom: true

  UIImageView
    id: pokemonIcon
    size: 44 44
    anchors.centerIn: parent
    phantom: true

CharacterWidget < UIWidget
  height: 84
  background-color: #181818bb
  border-width: 1
  border-color: #303030
  focusable: true

  $hover:
    border-color: #5f9fc4
    background-color: #1b2830ee

  $focus:
    border-color: #ffffff
    background-color: #ffffff18

  Panel
    id: outfitFrame
    size: 70 70
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    background-color: #101010cc
    border-width: 1
    border-color: #404040
    phantom: true

    Creature
      id: outfitCreatureBox
      size: 64 64
      anchors.centerIn: parent
      background-color: alpha
      border-width: 0
      creatureDisplay:setCreature(creature)
      fixed-creature-size: true
      phantom: true

  Label
    id: name
    width: 125
    height: 18
    anchors.left: outfitFrame.right
    anchors.top: parent.top
    margin-left: 12
    margin-top: 14
    font: verdana-11px-monochrome
    color: #f2f5f7
    text-wrap: true
    phantom: true

  Label
    id: level
    width: 125
    height: 16
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 4
    font: verdana-11px-monochrome
    color: #a8a8a8
    phantom: true

  Label
    id: server
    width: 125
    height: 16
    anchors.left: name.left
    anchors.top: level.bottom
    margin-top: 2
    font: verdana-11px-monochrome
    color: #78b8db
    phantom: true

  Panel
    id: pokemonTeam
    size: 337 52
    anchors.left: name.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true

    CharacterPokemonSlot
      id: pokemon1
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    CharacterPokemonSlot
      id: pokemon2
      anchors.left: pokemon1.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

    CharacterPokemonSlot
      id: pokemon3
      anchors.left: pokemon2.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

    CharacterPokemonSlot
      id: pokemon4
      anchors.left: pokemon3.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

    CharacterPokemonSlot
      id: pokemon5
      anchors.left: pokemon4.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

    CharacterPokemonSlot
      id: pokemon6
      anchors.left: pokemon5.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

MainWindow
  id: charactersWindow
  !text: tr('Character List')
  size: 650 475
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Down', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)

  TextList
    id: characters
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: characterListScrollBar.left
    anchors.bottom: accountStatusCaption.top
    margin-bottom: 7
    padding: 4
    background-color: #101010dd
    focusable: false
    vertical-scrollbar: characterListScrollBar
    auto-focus: first

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: parent.top
    anchors.bottom: accountStatusCaption.top
    anchors.right: parent.right
    margin-bottom: 7
    step: 88
    pixels-scroll: true

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    anchors.left: parent.left
    anchors.bottom: accountStatusLabel.top
    margin-bottom: 2

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-bottom: 7
    text-auto-resize: true

    $on:
      color: #FF0000

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonOk.top
    margin-bottom: 10

  SuccessButton
    id: buttonCreateCharacter
    !text: tr('Create character')
    width: 110
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onClick: CharacterCreation.show()

  SuccessButton
    id: buttonOk
    !text: tr('Ok')
    width: 64
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: CharacterList.doLogin()

  DangerButton
    id: buttonCancel
    !text: tr('Cancel')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.hide(true)
