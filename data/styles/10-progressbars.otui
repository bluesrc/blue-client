ProgressBar < UIProgressBar
  height: 16
  background-color: #e6e6e6
  border-width: 1
  border-color: #0b1116
  font: verdana-11px-rounded
  text-offset: 0 2

  $!on:
    visible: false
    margin-top: 0
    margin-bottom: 0
    height: 0

LifeProgressBar < UIProgressBar
  height: 16
  background-color: #4f9f62
  border: 1 #0b1116
  font: verdana-11px-rounded
  text-offset: 0 2
  margin: 2

ProgressRect < UIProgressRect
  anchors.fill: parent
  phantom: true
  color: #f2f5f7
  background-color: #0d0d0dcc
  font: verdana-11px-rounded
