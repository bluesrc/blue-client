MoveableTabBar < UIMoveableTabBar
  size: 80 21
MoveableTabBarPanel < Panel
MoveableTabBarButton < UIButton
  size: 20 21
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  icon-color: #d2d2d2
  color: #d2d2d2
  anchors.top: parent.top
  anchors.left: parent.left
  padding: 5

  $hover !checked:
    image-color: #ffffff
    image-clip: 0 23 22 23
    color: #ffffff
    icon-color: #ffffff

  $disabled:
    image-color: #70707066
    icon-color: #a8a8a866
    color: #a8a8a866

  $checked:
    image-color: #ffffff
    image-clip: 0 46 22 23
    color: #101010
    icon-color: #ffffff

  $on !checked:
    color: #ffffff

TabBar < UITabBar
  size: 80 21
  Panel
    id: buttonsPanel
    anchors.fill: parent
TabBarPanel < Panel
TabBarButton < UIButton
  size: 20 21
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  icon-color: #d2d2d2
  color: #d2d2d2
  anchors.top: parent.top
  padding: 5

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 5

  $hover !checked:
    image-color: #ffffff
    image-clip: 0 23 22 23
    color: #ffffff
    icon-color: #ffffff

  $disabled:
    image-color: #70707066
    icon-color: #a8a8a866
    color: #a8a8a866

  $checked:
    image-color: #ffffff
    image-clip: 0 46 22 23
    color: #101010
    icon-color: #ffffff

  $on !checked:
    color: #ffffff

TabBarRounded < TabBar
TabBarRoundedPanel < TabBarPanel
TabBarRoundedButton < TabBarButton
  size: 22 23

TabBarVertical < UITabBar
  width: 96
  ScrollablePanel
    id: buttonsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
TabBarVerticalPanel < Panel
TabBarVerticalButton < UIButton
  size: 48 48
  color: #a8a8a8
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  anchors.left: parent.left
  anchors.right: parent.right
  text-align: bottom
  icon-align: top
  icon-offset-y: 2
  icon-color: #a8a8a8
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 10
  $hover !checked:
    color: #ffffff
    icon-color: #ffffff
    image-color: #ffffff
    image-clip: 0 23 22 23
  $disabled:
    icon-color: #60718066
  $checked:
    icon-color: #ffffff
    color: #101010
    image-color: #ffffff
    image-clip: 0 46 22 23
  $on !checked:
    color: #ffffff
