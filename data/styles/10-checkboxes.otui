CheckBox < UICheckBox
  size: 16 16
  text-align: left
  text-offset: 18 1
  color: #e0e0e0
  image-color: #ffffff
  image-rect: 0 0 15 15
  image-source: /images/ui/theme_checkbox

  $hover !disabled:
    color: #ffffff
    image-color: #ffffff

  $!checked:
    image-clip: 0 0 15 15

  $hover !checked:
    image-clip: 0 15 15 15

  $checked:
    image-clip: 0 30 15 15
    image-color: #ffffff

  $hover checked:
    image-clip: 0 45 15 15
    image-color: #ffffff

  $disabled:
    image-color: #60718066
    color: #a8a8a866
    opacity: 0.8

ColorBox < UICheckBox
  size: 16 16
  image-color: #a8a8a8ff
  image-source: /images/ui/colorbox

  $checked:
    image-clip: 16 0 16 16

  $!checked:
    image-clip: 0 0 16 16

ButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #f2f5f7
  size: 106 23
  text-offset: 0 0
  text-align: center
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4

  $hover !disabled:
    image-color: #ffffff
    image-clip: 0 23 22 23

  $checked:
    image-color: #ffffff
    image-clip: 0 46 22 23
    color: #101010
    icon-color: #ffffff

  $disabled:
    color: #a8a8a866
    image-color: #70707066

ButtonBoxRounded < ButtonBox
