Label < UILabel
  font: verdana-11px-antialised
  color: #e0e0e0

  $disabled:
    color: #a8a8a866

FlatLabel < UILabel
  font: verdana-11px-antialised
  color: #e0e0e0
  size: 86 20
  text-offset: 3 3
  background-color: alpha
  border-width: 0
  image-source: /images/ui/button_rounded
  image-color: #505050
  image-clip: 0 0 22 23
  image-border: 4

  $disabled:
    color: #a8a8a866

MenuLabel < Label

GameLabel < UILabel
  font: verdana-11px-antialised
  color: #e0e0e0
