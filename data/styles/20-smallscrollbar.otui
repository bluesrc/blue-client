SmallScrollBar < UIScrollBar
  orientation: vertical
  margin-bottom: 1
  step: 20
  width: 8
  background-color: alpha
  border-width: 0
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 0 13 13
    image-color: #ffffff
    size: 8 8
    $hover:
      image-clip: 13 0 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 0 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 8 8
    image-source: /images/ui/theme_scrollbar
    image-clip: 0 13 13 13
    image-color: #ffffff
    $hover:
      image-clip: 13 13 13 13
      image-color: #ffffff
    $pressed:
      image-clip: 26 13 13 13
      image-color: #ffffff
    $disabled:
      image-color: #60718066

  UIButton
    id: sliderButton
    anchors.centerIn: parent
    size: 8 11
    background-color: #686868
    border-width: 0
    $hover:
      background-color: #ffffff
    $pressed:
      background-color: #d2d2d2
    $disabled:
      background-color: #48484866
        
  Label
    id: valueLabel
    anchors.fill: parent
    color: white
    text-align: center
