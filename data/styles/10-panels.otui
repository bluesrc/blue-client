Panel < UIWidget
  phantom: true
  auto-focus: first

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

FlatPanel < Panel
  background-color: alpha
  border-width: 0
  image-source: /images/ui/window_headless
  image-color: #484848
  image-border: 5

ScrollableFlatPanel < ScrollablePanel
  background-color: alpha
  border-width: 0
  image-source: /images/ui/window_headless
  image-color: #484848
  image-border: 5

LightFlatPanel < Panel
  background-color: alpha
  border-width: 0
  image-source: /images/ui/window_headless
  image-color: #606060
  image-border: 5
