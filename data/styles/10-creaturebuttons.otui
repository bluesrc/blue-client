CreatureButton < UICreatureButton
  height: 20
  margin-bottom: 5
  background-color: alpha
  border-width: 1
  border-color: alpha

  $hover:
    background-color: #ffffff0c
    border-color: #686868

  $on:
    background-color: #ffffff18
    border-color: alpha

  UICreature
    id: creature
    size: 20 20
    anchors.left: parent.left
    anchors.top: parent.top
    phantom: true

  UIWidget
    id: spacer
    width: 5
    anchors.left: creature.right
    anchors.top: creature.top
    phantom: true

  UIWidget
    id: emblem
    height: 11
    anchors.left: spacer.right
    anchors.top: creature.top
    phantom: true

  Label
    id: label
    anchors.left: emblem.right
    anchors.top: creature.top
    color: #a8a8a8
    margin-left: 2
    phantom: true

  LifeProgressBar
    id: lifeBar
    height: 5
    anchors.left: spacer.right
    anchors.right: parent.right
    anchors.top: label.bottom
    margin-top: 2
    phantom: true
