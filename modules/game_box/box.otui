BoxPartySlot < Item
  size: 42 42
  border-width: 1
  border-color: #404040

  $on:
    border-width: 2
    border-color: #e6e6e6

BoxInventorySlot < Item
  size: 34 34
  padding: 1
  border-width: 1
  border-color: #303030

BoxItemSlot < Item
  size: 42 42
  border-width: 0
  border-color: #303030

  $on:
    border-width: 2
    border-color: #e6e6e6

BoxSelectorButton < TabButton
  size: 42 28

MainWindow
  id: boxWindow
  !text: tr('Player Box')
  size: 800 570
  @onEscape: modules.game_box.closeBox()

  Panel
    id: sidePanel
    width: 200
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: closeButton.top
    margin-top: 5
    margin-bottom: 10

    FlatPanel
      id: inventoryPanel
      anchors.fill: parent
      padding: 8

      Label
        !text: tr('Inventory')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        color: #f3d66c
        font: verdana-11px-rounded
        text-auto-resize: true

      Panel
        id: inventorySourceTabs
        height: 24
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6

        TabButton
          id: inventoryItemsTab
          !text: tr('Items')
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          checked: true
          on: true
          @onClick: modules.game_box.selectInventorySource('items')

        TabButton
          id: inventoryLootTab
          !text: tr('Loot')
          anchors.left: parent.horizontalCenter
          anchors.right: parent.right
          @onClick: modules.game_box.selectInventorySource('loot')

      Button
        id: inventoryUpButton
        !text: tr('Back')
        size: 56 20
        anchors.left: parent.left
        anchors.top: inventorySourceTabs.bottom
        margin-top: 5
        visible: false
        @onClick: modules.game_box.openInventoryParent()

      Label
        id: inventoryName
        anchors.left: inventoryUpButton.right
        anchors.right: parent.right
        anchors.verticalCenter: inventoryUpButton.verticalCenter
        margin-left: 7
        text-align: center
        text-auto-resize: false
        color: #b7c2ce

      VerticalScrollBar
        id: inventoryScroll
        anchors.top: inventoryUpButton.bottom
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 8
        step: 36
        pixels-scroll: true

      ScrollablePanel
        id: inventoryItemsFrame
        anchors.left: parent.left
        anchors.right: inventoryScroll.left
        anchors.top: inventoryScroll.top
        anchors.bottom: parent.bottom
        margin-right: 4
        vertical-scrollbar: inventoryScroll

        Panel
          id: inventoryItems
          width: 144
          height: 0
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          layout:
            type: grid
            cell-size: 36 36
            num-columns: 4
            flow: true

    FlatPanel
      id: partyPanel
      anchors.fill: parent
      visible: false

      Panel
        id: partySlotsPanel
        size: 42 287
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter

        BoxPartySlot
          id: slot11
          &position: {x=65535, y=11, z=0}
          anchors.top: parent.top
          anchors.left: parent.left

        BoxPartySlot
          id: slot12
          &position: {x=65535, y=12, z=0}
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 7

        BoxPartySlot
          id: slot13
          &position: {x=65535, y=13, z=0}
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 7

        BoxPartySlot
          id: slot14
          &position: {x=65535, y=14, z=0}
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 7

        BoxPartySlot
          id: slot15
          &position: {x=65535, y=15, z=0}
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 7

        BoxPartySlot
          id: slot16
          &position: {x=65535, y=16, z=0}
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 7

      Label
        !text: tr('Pokebag')
        anchors.bottom: partySlotsPanel.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-bottom: 8
        text-auto-resize: true

  Panel
    id: boxArea
    anchors.left: sidePanel.right
    anchors.right: pokemonDetailsHost.left
    anchors.top: parent.top
    anchors.bottom: closeButton.top
    margin-left: 10
    margin-bottom: 10

    TabButton
      id: itemTab
      !tooltip: tr('Five boxes reserved for items')
      !text: tr('Items')
      checked: true
      on: true
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      anchors.top: parent.top
      margin-right: 3
      margin-top: 5

    TabButton
      id: pokemonTab
      !tooltip: tr('Twelve boxes reserved for Pokemon')
      !text: tr('Pokemon')
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 3
      margin-top: 5

    Label
      id: categoryLabel
      anchors.left: parent.left
      anchors.top: itemTab.bottom
      margin-top: 14
      text-auto-resize: true

    Panel
      id: selectorPanel
      height: 30
      anchors.left: categoryLabel.right
      anchors.right: parent.right
      anchors.verticalCenter: categoryLabel.verticalCenter
      margin-left: 12

    FlatPanel
      id: storagePanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: selectorPanel.bottom
      anchors.bottom: pagePanel.top
      margin-top: 10
      margin-bottom: 8

      UIImageView
        id: protectionZoneIcon
        size: 16 16
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 6
        margin-right: 8
        image-source: /images/game/states/protection_zone
        !tooltip: tr('Editing enabled in protection zone')
        visible: false

      Panel
        id: contentsPanel
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        size: 336 168
        layout:
          type: grid
          cell-size: 42 42
          num-columns: 8
          flow: true

    Panel
      id: pagePanel
      height: 24
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      visible: false

      Label
        id: pageLabel
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        text-auto-resize: true

  Panel
    id: pokemonDetailsHost
    width: 0
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: closeButton.top
    margin-bottom: 10
    visible: false

    VerticalSeparator
      id: pokemonDetailsSeparator
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 7
      margin-top: 5
      margin-bottom: 5

    FlatPanel
      id: pokemonDetailsFrame
      anchors.left: pokemonDetailsSeparator.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 14
      margin-top: 5
      margin-bottom: 5
      padding: 10
      border-width: 1
      border-color: #404040

      Label
        id: pokemonDetailsTitle
        !text: tr('Pokemon information')
        anchors.left: parent.left
        anchors.top: parent.top
        color: #f3d66c
        font: verdana-11px-rounded
        text-auto-resize: true

      DangerButton
        id: closePokemonDetailsButton
        !text: tr('Close info')
        size: 84 22
        anchors.right: parent.right
        anchors.verticalCenter: pokemonDetailsTitle.verticalCenter
        @onClick: modules.game_box.deselectPokemon()

      Panel
        id: pokemonDetailsContent
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: pokemonDetailsTitle.bottom
        anchors.bottom: parent.bottom
        margin-top: 9

  DangerButton
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_box.closeBox()
