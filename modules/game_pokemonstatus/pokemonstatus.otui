PokemonStageIndicator < Panel
  size: 38 22
  background-color: #18181866
  border-width: 1
  border-color: #68686866
  phantom: false
  focusable: false

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 18 18
    image-size: 18 18
    phantom: true

  Label
    id: stage
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    color: #d7e2eb
    font: verdana-11px-rounded
    text-align: center
    phantom: true

PokemonConditionIndicator < Panel
  size: 22 22
  visible: false
  background-color: #18181866
  border-width: 1
  border-color: #68686866
  phantom: false
  focusable: false

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 18 18
    image-size: 18 18
    phantom: true

Panel
  id: pokemonStatusWindow
  anchors.left: parent.left
  anchors.bottom: pokemonMovesWindow.top
  margin-left: 12
  margin-bottom: 4
  width: 210
  height: 26
  visible: false
  phantom: false
  focusable: false

  Panel
    id: fixedStages
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26
    padding: 2
    layout:
      type: horizontalBox
      spacing: 3

    PokemonStageIndicator
      id: attack

    PokemonStageIndicator
      id: defense

    PokemonStageIndicator
      id: specialAttack

    PokemonStageIndicator
      id: specialDefense

    PokemonStageIndicator
      id: speed

  Panel
    id: dynamicStatuses
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: fixedStages.top
    margin-bottom: 4
    height: 22
    padding-left: 2
    padding-right: 2
    visible: false
    layout:
      type: horizontalBox
      spacing: 4

    PokemonStageIndicator
      id: accuracy
      visible: false

    PokemonConditionIndicator
      id: burn

    PokemonConditionIndicator
      id: freeze

    PokemonConditionIndicator
      id: paralysis

    PokemonConditionIndicator
      id: poison

    PokemonConditionIndicator
      id: sleep

    PokemonConditionIndicator
      id: confusion

    PokemonConditionIndicator
      id: flinch
