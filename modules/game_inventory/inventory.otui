InventoryBagSlot < Item
  size: 34 34
  padding: 1
  border-width: 1
  border-color: #303030

InventoryTabButton < TabButton
  height: 24
  text-align: center

MiniWindow
  id: inventoryWindow
  !text: tr('Inventory')
  icon: /images/topbuttons/inventory
  width: 202
  height: 211
  @onOpen: modules.game_inventory.onMiniWindowOpen()
  @onClose: modules.game_inventory.onMiniWindowClose()
  &save: true

  MiniWindowContents
    padding: 4

    Panel
      id: tabsPanel
      height: 24
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

      InventoryTabButton
        id: itemsTab
        !text: tr('Items')
        !tooltip: tr('Drop loot here to move it to your items bag')
        anchors.left: parent.left
        anchors.right: parent.horizontalCenter
        @onClick: modules.game_inventory.selectTab('items')

      InventoryTabButton
        id: lootTab
        !text: tr('Loot')
        anchors.left: parent.horizontalCenter
        anchors.right: parent.right
        @onClick: modules.game_inventory.selectTab('loot')

    Panel
      id: itemsPage
      anchors.top: tabsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom

      Button
        id: itemsUpButton
        !text: tr('Back')
        size: 48 20
        anchors.top: parent.top
        anchors.left: parent.left
        visible: false
        @onClick: modules.game_inventory.openContainerParent('items')

      Label
        id: itemsName
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        text-align: center
        color: #b7c2ce

      VerticalScrollBar
        id: itemsScroll
        anchors.top: itemsName.bottom
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        step: 36
        pixels-scroll: true

      ScrollablePanel
        id: itemsFrame
        anchors.top: itemsScroll.top
        anchors.left: parent.left
        anchors.right: itemsScroll.left
        anchors.bottom: parent.bottom
        margin-right: 2
        vertical-scrollbar: itemsScroll

        Panel
          id: itemsGrid
          width: 175
          height: 0
          anchors.top: parent.top
          anchors.right: parent.right
          layout:
            type: grid
            cell-size: 35 35
            num-columns: 5
            flow: true

    Panel
      id: lootPage
      anchors.top: tabsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      visible: false

      Button
        id: lootUpButton
        !text: tr('Back')
        size: 48 20
        anchors.top: parent.top
        anchors.left: parent.left
        visible: false
        @onClick: modules.game_inventory.openContainerParent('loot')

      Label
        id: lootName
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        text-align: center
        color: #b7c2ce

      VerticalScrollBar
        id: lootScroll
        anchors.top: lootName.bottom
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        step: 36
        pixels-scroll: true

      ScrollablePanel
        id: lootFrame
        anchors.top: lootScroll.top
        anchors.left: parent.left
        anchors.right: lootScroll.left
        anchors.bottom: parent.bottom
        margin-right: 2
        vertical-scrollbar: lootScroll

        Panel
          id: lootGrid
          width: 175
          height: 0
          anchors.top: parent.top
          anchors.right: parent.right
          layout:
            type: grid
            cell-size: 35 35
            num-columns: 5
            flow: true
