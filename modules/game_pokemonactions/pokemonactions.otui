PokemonCooldownAction < Panel
  size: 32 32
  visible: false
  background-color: #181818cc
  border-width: 2
  border-color: #858585
  padding: 2
  phantom: false
  focusable: false

  UIWidget
    id: actionIcon
    anchors.centerIn: parent
    size: 22 22
    image-size: 22 22
    phantom: true

  UIProgressRect
    id: cooldownProgress
    anchors.fill: parent
    margin: 1
    background: #080b0dcc
    percent: 100
    color: #ffffff
    font: verdana-11px-rounded
    text-align: center
    phantom: true
    visible: false

Panel
  id: pokemonActionsWindow
  anchors.left: parent.left
  anchors.top: parent.top
  margin-left: 12
  margin-top: 32
  width: 32
  height: 32
  visible: false
  phantom: false
  focusable: false
  layout:
    type: horizontalBox
    spacing: 6

  PokemonCooldownAction
    id: actionCooldown
    tooltip: Action: ready

  PokemonCooldownAction
    id: gobackCooldown
    tooltip: GoBack: ready

  PokemonCooldownAction
    id: tryCatchCooldown
    tooltip: TryCatch: ready

  PokemonCooldownAction
    id: combatCooldown
    tooltip: Combat lock: ready

  PokemonCooldownAction
    id: potionCooldown
    tooltip: Potions: ready

  PokemonCooldownAction
    id: reviveCooldown
    tooltip: Revives: ready

  PokemonCooldownAction
    id: cureCooldown
    tooltip: Cures: ready
