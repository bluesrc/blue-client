PokebarActivePokemon < UIImageView
  id: activePokemon
  size: 72 72

PokebarItem < UIImageView
  id: pokemon
  size: 36 36
  anchors.horizontalCenter: parent.horizontalCenter

  ProgressBar
    id: healthBar
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 36 5

PokebarActive < Panel
  size: 72 72
  anchors.horizontalCenter: parent.horizontalCenter

  PokebarActivePokemon
    id: activePokemon
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter

  ProgressBar
    id: activeHealthBar
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 60 15

Panel
  id: pokebarWindow
  anchors.left: parent.left
  anchors.verticalCenter: parent.verticalCenter
  width: 75
  height: 1
  visible: true
  draggable: false
  phantom: false
  focusable: true
  &save: true
