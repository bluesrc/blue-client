Button < UIButton
  font: verdana-11px-antialised
  color: #f2f5f7
  size: 106 23
  text-offset: 0 0
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_button_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  padding: 5 10 5 10
  opacity: 1.0

  $hover !disabled:
    color: #ffffff
    image-color: #ffffff
    image-clip: 0 23 22 23

  $pressed:
    color: #ffffff
    icon-color: #ffffff
    image-color: #ffffff
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #a8a8a866
    image-color: #70707088
    opacity: 0.75

PrimaryButton < Button
  image-source: /images/ui/theme_button_warning

  $pressed:
    color: #ffffff
    icon-color: #ffffff

SecondaryButton < Button
  image-source: /images/ui/theme_button_neutral

SuccessButton < Button
  image-source: /images/ui/theme_button_success

  $pressed:
    color: #ffffff
    icon-color: #ffffff

DangerButton < Button
  image-source: /images/ui/theme_button_danger

  $pressed:
    color: #ffffff
    icon-color: #ffffff

WarningButton < Button
  image-source: /images/ui/theme_button_warning

  $pressed:
    color: #ffffff
    icon-color: #ffffff

TabButton < UIButton
  size: 22 23
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  icon-color: #d2d2d2
  color: #d2d2d2

  $hover !on:
    image-color: #ffffff
    image-clip: 0 23 22 23
    icon-color: #ffffff
    color: #ffffff

  $disabled:
    image-color: #70707066
    icon-color: #a8a8a866
    color: #a8a8a866

  $on:
    image-color: #ffffff
    image-clip: 0 46 22 23
    icon-color: #ffffff
    color: #101010

  $checked:
    image-color: #ffffff
    image-clip: 0 46 22 23
    icon-color: #ffffff
    color: #101010

NextButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 12 0 12 21
  image-color: #d2d2d2

  $hover !disabled:
    image-clip: 12 21 12 21
    image-color: #ffffff

  $pressed:
    image-clip: 12 21 12 21
    image-color: #ffffff

  $disabled:
    image-color: #60718066

PreviousButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 0 0 12 21
  image-color: #d2d2d2

  $hover !disabled:
    image-clip: 0 21 12 21
    image-color: #ffffff

  $pressed:
    image-clip: 0 21 12 21
    image-color: #ffffff

  $disabled:
    image-color: #60718066

AddButton < UIButton
  size: 20 20
  image-source: /images/ui/icon_add
  image-color: #67ad78

  $hover !disabled:
    image-color: #80c991

  $pressed:
    image-color: #a8a8a8

  $disabled:
    image-color: #60718066
