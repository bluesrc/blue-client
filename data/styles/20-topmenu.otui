TopButton < UIButton
  size: 26 26
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  icon-color: #ffffff

  $on:
    image-color: #ffffff
    image-clip: 0 46 22 23
    icon-color: #ffffff

  $hover !disabled:
    image-color: #ffffff
    image-clip: 0 23 22 23
    icon-color: #ffffff

  $pressed:
    image-color: #ffffff
    image-clip: 0 46 22 23
    icon-color: #ffffff

  $disabled:
    image-color: #70707066
    icon-color: #60718066

TopToggleButton < UIButton
  size: 26 26
  background-color: alpha
  border-width: 0
  image-source: /images/ui/theme_tab_neutral
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 4
  icon-color: #ffffff

  $on:
    image-color: #ffffff
    image-clip: 0 46 22 23
    icon-color: #ffffff

  $hover:
    image-color: #ffffff
    image-clip: 0 23 22 23

TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 4
    fit-children: true
  padding: 6 4

TopMenuPanel < Panel
  height: 36
  background-color: #18181888
  border-width: 1
  border-color: #40404088
  focusable: false

TopMenuFrameCounterLabel < Label
  font: verdana-11px-rounded
  color: #d8e1e8
  margin-top: 4
  margin-left: 5

TopMenuPingLabel < Label
  font: verdana-11px-rounded
