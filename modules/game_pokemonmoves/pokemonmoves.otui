PokemonMoveEntry < Panel
  width: 210
  height: 38
  background-color: #111820dd
  border-width: 1
  border-color: #637383
  padding: 5
  phantom: false
  focusable: false

  ProgressBar
    id: cooldownProgress
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 5
    percent: 100
    background-color: #4f9f62
    phantom: true

  Label
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-bottom: 2
    width: 42
    color: #8fa8bd
    font: verdana-11px-monochrome
    text-align: center
    phantom: true

  Label
    id: moveName
    anchors.left: slot.right
    anchors.right: cooldown.left
    anchors.verticalCenter: parent.verticalCenter
    margin-bottom: 2
    margin-left: 3
    margin-right: 6
    color: #f2f5f7
    font: verdana-11px-monochrome
    text-align: left
    phantom: true

  Label
    id: cooldown
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-bottom: 2
    width: 48
    color: #8fd694
    font: verdana-11px-monochrome
    text-align: right
    phantom: true

Panel
  id: pokemonMovesWindow
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  margin-left: 12
  margin-bottom: 12
  width: 210
  height: 1
  visible: false
  phantom: false
  focusable: false
  layout:
    type: verticalBox
    spacing: 4
